{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Seeding": {
    "UseJson": true,
    "JsonFile": "samples.json",
    "UseCsv": false,
    "CsvFile": "samples.csv"
  },
  "ExternalApi": {
    "BaseUrl": "https://api.nasa.gov/",
    "ApiKeyLocation": "Query",
    "ApiKeyName": "api_key",
    "ApiKey": "DEMO_KEY",
    "TimeoutSeconds": 15
  }
}